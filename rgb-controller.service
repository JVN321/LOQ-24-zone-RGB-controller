[Unit]
Description=Lenovo LOQ RGB Controller Daemon
After=graphical-session.target

[Service]
# Points to the wrapper script that dynamically sets up the Wayland environment
ExecStart=%h/.local/bin/rgb-server-wrapper.sh
Restart=always
RestartSec=3

# Ensure user session environment variables are imported
# (Required for Wayland screen capture/grim to work)
Environment=PATH=/usr/bin:/usr/local/bin:%h/.local/bin

[Install]
WantedBy=default.target
